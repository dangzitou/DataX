{
  "common": {
    "column": {
      "timeZone": "UTC"
    }
  },
  "core": {
    "container": {
      "job": {
        "sleepInterval": 200
      },
      "taskGroup": {
        "channel": 1
      }
    }
  },
  "job": {
    "setting": {
      "speed": {
        "channel": 1
      },
      "errorLimit": {
        "record": 0
      }
    },
    "content": [
      {
        "reader": {
          "name": "postgresqlreader",
          "parameter": {
            "username": "postgres",
            "password": "datax-local-benchmark",
            "fetchSize": 1024,
            "connection": [
              {
                "jdbcUrl": [
                  "jdbc:postgresql://127.0.0.1:25432/datax_bench"
                ],
                "table": [
                  "pg_perf_source"
                ]
              }
            ],
            "column": [
              "id",
              "tenant",
              "amount",
              "created",
              "message",
              "payload"
            ]
          }
        },
        "writer": {
          "name": "postgresqlwriter",
          "parameter": {
            "username": "postgres",
            "password": "datax-local-benchmark",
            "column": [
              "id",
              "tenant",
              "amount",
              "created",
              "message",
              "payload"
            ],
            "batchSize": 1024,
            "connection": [
              {
                "jdbcUrl": "jdbc:postgresql://127.0.0.1:25432/datax_bench",
                "table": [
                  "pg_perf_target"
                ]
              }
            ]
          }
        }
      }
    ]
  }
}