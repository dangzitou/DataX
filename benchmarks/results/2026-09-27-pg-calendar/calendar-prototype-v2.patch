--- a/plugin-rdbms-util/src/test/java/com/alibaba/datax/plugin/rdbms/reader/RdbmsReaderRegressionTest.java
+++ b/plugin-rdbms-util/src/test/java/com/alibaba/datax/plugin/rdbms/reader/RdbmsReaderRegressionTest.java
@@ -169,4 +169,25 @@ public class RdbmsReaderRegressionTest {
         assertEquals(0,collector.dirty);
         assertEquals(2,sender.rows.size());
     }
+
+    @Test public void postgresqlTemporalValuesRetainNativeTextAndNull() throws Exception {
+        for (String name : new String[]{"date", "timestamp", "timestamptz"}) {
+            ResultSetMetaData meta = metadata("date".equals(name) ? Types.DATE : Types.TIMESTAMP);
+            when(meta.getColumnTypeName(1)).thenReturn(name);
+            ResultSet rs = mock(ResultSet.class);
+            when(rs.getString(1)).thenReturn("date".equals(name) ? "2011-12-30" : "2024-03-10 02:30:00.123456");
+            Task task = new Task(DataBaseType.PostgreSQL);
+            Sender sender = new Sender(); Collector collector = new Collector();
+            task.read(sender, rs, meta, "", collector);
+            Column value = sender.rows.get(0).getColumn(0);
+            assertEquals(Column.Type.STRING, value.getType());
+            assertEquals("date".equals(name) ? "2011-12-30" : "2024-03-10 02:30:00.123456", value.asString());
+            verify(rs, never()).getDate(1);
+            verify(rs, never()).getTimestamp(1);
+            when(rs.getString(1)).thenReturn(null);
+            task.read(sender, rs, meta, "", collector);
+            assertNull(sender.rows.get(1).getColumn(0).getRawData());
+            assertEquals(0, collector.dirty);
+        }
+    }
 }
